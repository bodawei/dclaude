{
  "name": "dclaude",
  "version": "0.1.0",
  "description": "Dump Claude Code token usage (per turn and per API call) from ~/.claude/projects as Markdown, CSV, or a live top-style view (--tail)",
  "keywords": [
    "anthropic",
    "claude",
    "claude-code",
    "cli",
    "prompt-caching",
    "tokens",
    "usage"
  ],
  "license": "MIT",
  "bin": {
    "dclaude": "bin/dclaude.mjs"
  },
  "files": [
    "bin/",
    "lib/",
    "README.md"
  ],
  "type": "module",
  "scripts": {
    "test": "node --test",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "devDependencies": {
    "oxfmt": "^0.80.0",
    "oxlint": "^1.95.0"
  },
  "engines": {
    "node": ">=21"
  },
  "packageManager": "pnpm@10.33.3"
}
