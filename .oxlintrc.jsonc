{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["unicorn", "oxc", "import", "node"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn",
  },
  "env": {
    "node": true,
    "es2024": true,
  },
  "ignorePatterns": ["**/node_modules/**", "**/coverage/**"],
}
